APP_NAME=LearnIn
DEBUG=True

# Supabase PostgreSQL connection string
# postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/learnin

# Used to sign admin JWT access tokens - generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

JWT_ALGORITHM=HS256
# Fallback session length (minutes) for any role that doesn't set its own
# override below.
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Per-role overrides - uncomment to give a role its own session length
# instead of ACCESS_TOKEN_EXPIRE_MINUTES.
#STUDENT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
#INSTITUTION_ACCESS_TOKEN_EXPIRE_MINUTES=1440
#ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# How long a signup/login OTP (and the pending-signup cookie carrying it)
# stays valid, in minutes.
OTP_EXPIRE_MINUTES=10

# Google Drive root folder that stores the Exams/Departments/Subjects/
# Papers/Resources/Blogs subfolders.
GOOGLE_DRIVE_FOLDER_ID=your-root-drive-folder-id

# Run `python scripts/authorize_google_drive.py <client_id> <client_secret>`
# once to get these. A bare service account cannot upload file content
# (Google returns storageQuotaExceeded) - files upload under this real
# Google account's own Drive storage instead.
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=your-oauth-refresh-token

# Gemini API key, used for OCR/text extraction in the paper processing
# pipeline (app/core/gemini_client.py / app/modules/paper_processing/extraction.py).
GEMINI_API_KEY=your-gemini-api-key

# Brevo SMTP relay (transactional email) - from Brevo > SMTP & API settings.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-login@smtp-brevo.com
SMTP_PASS=your-brevo-smtp-key
SENDER_EMAIL=your-verified-sender@example.com
